---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { url } from '../lib/url';
import { site } from '../data/site';
import { experience, skills, education } from '../data/experience';
import { publications, scholarMetrics } from '../data/publications';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const peerReviewed = publications.filter((p) => !p.kind).length;
---

<Base>
  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <section class="section section--flush hero">
    <div class="wrap">
      <p class="eyebrow hero__eyebrow">{site.role}</p>

      <h1 class="hero__title">
        I take autonomy from <em>theory</em> to <em>deployed hardware</em>.
      </h1>

      <p class="lede hero__lede">
        Ten years across swarm intelligence, industrial mobile robots and autonomous
        mobility — a PhD in collective behaviour, production C++ shipped on
        industrial AMRs, and field robotic deployments from the Venice lagoon to AI deployments in public
        transport in Austria.
      </p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#work">Selected work</a>
        <a class="btn" href={url(site.resume)}>View CV</a>
        <a class="btn" href={`mailto:${site.email}`}>Get in touch</a>
      </div>

      <dl class="hero__stats">
        <div><dt>10+</dt><dd>years in robotics</dd></div>
        <div><dt>€10M+</dt><dd>EU-funded research</dd></div>
        <div><dt>{peerReviewed}</dt><dd>peer-reviewed papers</dd></div>
        <div><dt>{scholarMetrics.citations}+</dt><dd>citations</dd></div>
      </dl>
    </div>
  </section>

  <!-- ── About ─────────────────────────────────────────────────────────── -->
  <section class="section" id="about">
    <div class="wrap about">
      <div class="about__intro">
        <p class="eyebrow">About</p>
        <p class="lede">
          I work at the seam where research meets hardware that has to survive
          contact with the real world.
        </p>
        <p class="about__body">
          My PhD asked whether the many bio-inspired swarm behaviours in the
          literature were really separate algorithms, or one algorithm wearing
          different clothes. Answering it meant taking theory all the way down to
          embedded C on robots dropped into the Venice lagoon. Since then I have
          spent three years writing production C++ for industrial mobile robots,
          and now lead EU-funded work on autonomous mobility and last-mile
          delivery at JKU. Some selected work is shown below. Scroll down for the organizations
          that I have previously worked for.
        </p>
        <p class="about__body">
          What connects those is a preference for systems that get built and
          measured rather than only published. I am most useful on problems that
          span the whole stack — perception and estimation through planning and
          control, down to the firmware and the wiring.
        </p>
        <p class="about__body">
          Currently based in {site.location}, and increasingly focused on bringing
          learning-based methods into deployed robotic systems.
        </p>
      </div>

      <div class="about__side">
        <h2 class="about__h">Capabilities</h2>
        <dl class="skills">
          {
            skills.map((g) => (
              <div class="skills__row">
                <dt>{g.group}</dt>
                <dd>{g.items.join(' · ')}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- ── Work ──────────────────────────────────────────────────────────── -->
  <section class="section" id="work">
    <div class="wrap">
      <p class="eyebrow">Selected work</p>
      <div class="rail" data-rail>
        <div
          class="work"
          role="region"
          aria-label="Selected work, horizontally scrollable"
          tabindex="0"
          data-rail-track
        >
          {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
        </div>

        <button
          class="rail__nav rail__nav--prev"
          type="button"
          data-rail-prev
          aria-label="Scroll to previous projects"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="1.75"
              stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button
          class="rail__nav rail__nav--next"
          type="button"
          data-rail-next
          aria-label="Scroll to next projects"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.75"
              stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>
  </section>

  <!-- ── Experience ────────────────────────────────────────────────────── -->
  <section class="section" id="experience">
    <div class="wrap">
      <p class="eyebrow">Experience</p>
      <ol class="cv">
        {
          experience.map((role) => (
            <li class="cv__item">
              <div class="cv__when mono">{role.period}</div>
              <div class="cv__what">
                <h3 class="cv__org">
                  {role.org} <span class="cv__loc">{role.location}</span>
                </h3>
                <p class="cv__title">{role.title}</p>
                <ul class="cv__points">
                  {role.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>

      <h2 class="about__h about__h--spaced">Education</h2>
      <ol class="cv">
        {
          education.map((ed) => (
            <li class="cv__item">
              <div class="cv__when mono">{ed.period}</div>
              <div class="cv__what">
                <h3 class="cv__org">{ed.school}</h3>
                <p class="cv__title">{ed.degree}</p>
                <p class="cv__note">{ed.note}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ── Contact ───────────────────────────────────────────────────────── -->
  <section class="section" id="contact">
    <div class="wrap wrap--narrow contact">
      <p class="eyebrow">Contact</p>
      <h2 class="contact__title">
        Open to roles bringing learning into deployed robotic systems.
      </h2>
      <p class="lede">
        If you are working on robot learning, autonomous mobility, or moving
        research-grade autonomy into products, I would like to hear about it.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="btn" href={site.linkedin} rel="noopener">LinkedIn</a>
        <a class="btn" href={url('/research')}>Publications</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .hero {
    padding-top: clamp(2.5rem, 7vw, 5rem);
  }

  .hero__eyebrow {
    white-space: nowrap;
  }

  .hero__title {
    font-size: clamp(2.2rem, 6.4vw, 4.35rem);
    max-width: 17ch;
    margin-bottom: 1.6rem;
  }

  .hero__title em {
    font-style: normal;
    color: var(--accent);
  }

  .hero__lede {
    max-width: 60ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2.1rem;
  }

  .btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    padding: 0.62rem 1.05rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--text);
    transition:
      border-color 0.15s,
      color 0.15s,
      background 0.15s;
  }

  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn--primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .btn--primary:hover {
    background: var(--accent-dim);
    border-color: var(--accent-dim);
    color: #fff;
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1.5rem;
    margin: clamp(3rem, 7vw, 5rem) 0 0;
    padding-top: 1.6rem;
    border-top: var(--rule);
  }

  .hero__stats dt {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .hero__stats dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.71rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* ── About ────────────────────────────────────────────────────────────── */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 4.5rem);
  }

  .about__body {
    color: var(--text-dim);
    max-width: var(--measure);
  }

  .about__intro .lede {
    margin-bottom: 1.6rem;
    color: var(--text);
  }

  /* Matches .eyebrow so Education and Capabilities read at the same level as
     About / Selected work / Experience rather than as small sub-labels. */
  .about__h {
    font-size: 1.5rem;
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dim);
    font-weight: 400;
    margin-bottom: 1.4rem;
  }

  .about__h--spaced {
    margin-top: 2.5rem;
  }

  .skills {
    margin: 0;
    border-top: var(--rule);
  }

  .skills__row {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .skills__row dt {
    font-size: 0.86rem;
    font-weight: 600;
    margin-bottom: 0.2rem;
  }

  .skills__row dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.7;
    color: var(--text-dim);
  }

  /* ── Work ─────────────────────────────────────────────────────────────── */
  /* Horizontal rail. The work section used to stack five full-width rows,
     which pushed Experience far below the fold; scrolling sideways keeps the
     whole section to roughly one card's height. */
  .work {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    /* proximity, not mandatory: mandatory re-snaps on every wheel tick and
       makes the translated vertical scrolling feel like it is fighting back. */
    scroll-snap-type: x proximity;
    /* Room for the scrollbar so it never overlaps the tag row. */
    padding-bottom: 1.1rem;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }

  .work > :global(.card) {
    flex: 0 0 var(--card-w);
    scroll-snap-align: start;
  }

  /* ── Rail affordances ────────────────────────────────────────────────── */
  .rail {
    /* Single source of truth: the nav buttons centre on the card's media box,
       whose height is card width x 10/16. */
    --card-w: clamp(278px, 74vw, 372px);
    position: relative;
  }

  /* Edge fades signal that content continues past the frame. They sit above
     the track and are switched on only in the direction that can still move. */
  .rail::before,
  .rail::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(1.75rem, 5vw, 3.5rem);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
    z-index: 1;
  }

  .rail::before {
    left: 0;
    background: linear-gradient(to right, var(--bg), transparent);
  }

  .rail::after {
    right: 0;
    background: linear-gradient(to left, var(--bg), transparent);
  }

  .rail[data-can-prev]::before,
  .rail[data-can-next]::after {
    opacity: 1;
  }

  .rail__nav {
    position: absolute;
    top: calc(var(--card-w) * 0.3125);
    transform: translateY(-50%);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: var(--rule);
    border-radius: 50%;
    background: var(--bg-raised);
    color: var(--text);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease, border-color 0.2s ease,
      color 0.2s ease;
    box-shadow: 0 1px 3px rgb(0 0 0 / 12%), 0 6px 18px rgb(0 0 0 / 10%);
  }

  .rail__nav svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .rail__nav--prev { left: -0.5rem; }
  .rail__nav--next { right: -0.5rem; }

  .rail[data-can-prev] .rail__nav--prev,
  .rail[data-can-next] .rail__nav--next {
    opacity: 1;
    visibility: visible;
  }

  .rail__nav:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .rail__nav:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    opacity: 1;
    visibility: visible;
  }

  /* Coarse pointers swipe; buttons would only cover content. */
  @media (hover: none) {
    .rail__nav { display: none; }
  }

  .work:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: 2px;
  }

  .work::-webkit-scrollbar {
    height: 8px;
  }

  .work::-webkit-scrollbar-track {
    background: transparent;
  }

  .work::-webkit-scrollbar-thumb {
    background: var(--line);
    border-radius: 99px;
  }

  .work::-webkit-scrollbar-thumb:hover {
    background: var(--text-faint);
  }


  /* ── CV list ──────────────────────────────────────────────────────────── */
  .cv {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cv__item {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 2.5rem);
    padding: 1.9rem 0;
    border-top: var(--rule);
  }

  .cv__item:last-child {
    border-bottom: var(--rule);
  }

  /* A list sitting directly under an eyebrow would draw a second rule a few
     rem below the eyebrow's own. Suppress it. (The Education list follows an
     .about__h, which draws no rule, so it keeps its top border.) */
  .eyebrow + .cv > .cv__item:first-child {
    border-top: 0;
  }

  .cv__when {
    padding-top: 0.3rem;
    white-space: nowrap;
  }

  .cv__org {
    font-size: 1.08rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.7rem;
  }

  .cv__loc {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    font-weight: 400;
  }

  .cv__title {
    margin: 0.25rem 0 0.9rem;
    color: var(--accent);
    font-size: 0.9rem;
  }

  .cv__points {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text-dim);
    font-size: 0.94rem;
    max-width: var(--measure);
  }

  .cv__points li + li {
    margin-top: 0.42rem;
  }

  .cv__points li::marker {
    color: var(--line);
  }

  .cv__note {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.92rem;
    max-width: var(--measure);
  }

  /* ── Contact ──────────────────────────────────────────────────────────── */
  .contact {
    text-align: left;
  }

  .contact__title {
    font-size: clamp(1.6rem, 4vw, 2.5rem);
    margin-bottom: 1.2rem;
    max-width: 20ch;
  }

  /* ── Responsive ───────────────────────────────────────────────────────── */
  @media (max-width: 880px) {
    .about {
      grid-template-columns: 1fr;
    }
    .cv__item {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
  }
</style>

<script>
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const track = rail?.querySelector<HTMLElement>('[data-rail-track]');
  const prev = rail?.querySelector<HTMLButtonElement>('[data-rail-prev]');
  const next = rail?.querySelector<HTMLButtonElement>('[data-rail-next]');

  if (rail && track && prev && next) {
    // Sub-pixel scroll positions never land exactly on 0 or max.
    const EDGE = 2;
    const maxScroll = () => track.scrollWidth - track.clientWidth;

    /* Show each affordance only in the direction that can still move. */
    const sync = () => {
      const max = maxScroll();
      const scrollable = max > EDGE;
      rail.toggleAttribute('data-can-prev', scrollable && track.scrollLeft > EDGE);
      rail.toggleAttribute('data-can-next', scrollable && track.scrollLeft < max - EDGE);
    };

    /* One card plus one gap, read from the DOM so the CSS clamp stays the
       single source of truth for card width. */
    const step = () => {
      const card = track.querySelector<HTMLElement>('.card');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card ? card.offsetWidth + gap : track.clientWidth * 0.8;
    };

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const nudge = (dir: number) =>
      track.scrollBy({
        left: dir * step(),
        behavior: reduced.matches ? 'auto' : 'smooth',
      });

    prev.addEventListener('click', () => nudge(-1));
    next.addEventListener('click', () => nudge(1));

    /* deltaY is not always pixels. Firefox on Linux commonly reports
       DOM_DELTA_LINE, where deltaY is ~3 (lines) rather than ~100 (pixels);
       using it raw moves the rail a few px per tick while preventDefault
       still blocks the page, which reads as scrolling being broken. */
    const pixelDelta = (e: WheelEvent) => {
      // 40px is the conventional browser line step for wheel events; a 16px
      // line-height would make Firefox/Linux scroll at a third of the speed.
      if (e.deltaMode === 1) return e.deltaY * 40; // lines
      if (e.deltaMode === 2) return e.deltaY * track.clientHeight; // pages
      return e.deltaY;
    };

    /* Snap fights an incremental scroll: each tick gets pulled back toward the
       nearest snap point. Suspend it while the wheel is active, then restore
       so the rail still settles on a card. */
    let snapTimer: number | undefined;
    const suspendSnap = () => {
      track.style.scrollSnapType = 'none';
      window.clearTimeout(snapTimer);
      snapTimer = window.setTimeout(() => {
        track.style.scrollSnapType = '';
      }, 150);
    };

    /* A vertical wheel over the rail scrolls it sideways. At either end the
       gesture is handed straight back to the page, so the rail never traps
       the reader mid-scroll. */
    rail.addEventListener(
      'wheel',
      (e) => {
        // Trackpad horizontal gestures already do the right thing.
        if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;

        const max = maxScroll();
        if (max <= EDGE) return;

        const delta = pixelDelta(e);
        const atStart = track.scrollLeft <= EDGE;
        const atEnd = track.scrollLeft >= max - EDGE;
        if ((delta < 0 && atStart) || (delta > 0 && atEnd)) return;

        e.preventDefault();
        suspendSnap();
        track.scrollLeft += delta;
      },
      { passive: false }
    );

    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  }
</script>
