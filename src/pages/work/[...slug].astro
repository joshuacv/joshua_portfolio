---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MediaLoop from '../../components/MediaLoop.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  const sorted = projects.sort((a, b) => a.data.order - b.data.order);

  return sorted.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      next: sorted[(i + 1) % sorted.length],
    },
  }));
}

const { project, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
---

<Base title={d.title} description={d.summary}>
  <article>
    <!-- ── Header ──────────────────────────────────────────────────────── -->
    <header class="ph">
      <div class="wrap">
        <a class="ph__back mono" href={url('/#work')}>← All work</a>

        <p class="ph__meta mono">
          <span>{d.org}</span>
          <span class="ph__dot" aria-hidden="true">·</span>
          <span>{d.role}</span>
          <span class="ph__dot" aria-hidden="true">·</span>
          <span>{d.period}</span>
        </p>

        <h1 class="ph__title">{d.title}</h1>
        <p class="ph__tagline">{d.tagline}</p>
      </div>
    </header>

    <!-- ── Hero media ──────────────────────────────────────────────────── -->
    <div class="wrap ph__media">
      <MediaLoop
        video={d.video}
        poster={d.poster}
        alt={`${d.title} - ${d.tagline}`}
        ratio="21 / 9"
        slotLabel="hero footage"
      />
    </div>

    <!-- ── At a glance ─────────────────────────────────────────────────── -->
    {
      (d.metrics.length > 0 || d.tags.length > 0 || d.links.length > 0) && (
        <div class="wrap">
          <div class="glance">
            {d.metrics.length > 0 && (
              <dl class="glance__metrics">
                {d.metrics.map((m) => (
                  <div>
                    <dt>{m.value}</dt>
                    <dd>{m.label}</dd>
                  </div>
                ))}
              </dl>
            )}

            <div class="glance__side">
              {d.tags.length > 0 && (
                <div class="glance__block">
                  <h2 class="glance__h">Stack</h2>
                  <p class="glance__tags">{d.tags.join(' · ')}</p>
                </div>
              )}

              {d.links.length > 0 && (
                <div class="glance__block">
                  <h2 class="glance__h">Links</h2>
                  <ul class="glance__links">
                    {d.links.map((l) => (
                      <li>
                        <a href={l.href} rel="noopener">
                          {l.label} ↗
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        </div>
      )
    }

    <!-- ── Body ────────────────────────────────────────────────────────── -->
    <div class="wrap">
      <div class="prose ph__body">
        <Content />
      </div>
    </div>

    <!-- ── Next ────────────────────────────────────────────────────────── -->
    <nav class="nextup">
      <div class="wrap">
        <a class="nextup__link" href={url(`/work/${next.id}`)}>
          <span class="mono">Next project</span>
          <span class="nextup__title">{next.data.title} →</span>
        </a>
      </div>
    </nav>
  </article>
</Base>

<style>
  .ph {
    padding-top: clamp(2.5rem, 7vw, 4.5rem);
    padding-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }

  .ph__back {
    display: inline-block;
    text-decoration: none;
    margin-bottom: 2.5rem;
  }

  .ph__back:hover {
    color: var(--accent);
  }

  .ph__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1rem;
  }

  .ph__dot {
    opacity: 0.5;
  }

  .ph__title {
    font-size: clamp(2rem, 5.4vw, 3.5rem);
    max-width: 18ch;
    margin-bottom: 0.7rem;
  }

  .ph__tagline {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    color: var(--accent);
    max-width: 48ch;
    margin: 0;
  }

  .ph__media {
    margin-bottom: clamp(2rem, 5vw, 3.25rem);
  }

  .ph__body {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  /* ── At a glance ──────────────────────────────────────────────────────── */
  .glance {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    padding: 1.9rem 0;
    /* Top rule only - the first prose h2 below draws its own, and a bottom
       rule here would sit consecutively with it. */
    border-top: var(--rule);
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .glance__metrics {
    display: grid;
    /* Two columns so an even count (2 or 4) stays balanced rather than
       leaving one metric stranded on its own row. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1.75rem;
    margin: 0;
  }

  .glance__metrics dt {
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  .glance__metrics dd {
    margin: 0.25rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    line-height: 1.5;
  }

  .glance__side {
    display: grid;
    gap: 1.4rem;
    align-content: start;
  }

  .glance__h {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-weight: 400;
    margin-bottom: 0.45rem;
  }

  .glance__tags {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.75;
    color: var(--text-dim);
  }

  .glance__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .glance__links a {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-decoration: none;
    color: var(--text-dim);
  }

  .glance__links a:hover {
    color: var(--accent);
  }

  /* ── Next up ──────────────────────────────────────────────────────────── */
  .nextup {
    border-top: var(--rule);
    padding-block: clamp(2.25rem, 6vw, 3.5rem);
  }

  .nextup__link {
    display: grid;
    gap: 0.5rem;
    text-decoration: none;
  }

  .nextup__title {
    font-size: clamp(1.35rem, 3.2vw, 2rem);
    font-weight: 620;
    letter-spacing: -0.022em;
    transition: color 0.15s;
  }

  .nextup__link:hover .nextup__title {
    color: var(--accent);
  }

  @media (max-width: 880px) {
    .glance {
      grid-template-columns: 1fr;
    }
  }
</style>
