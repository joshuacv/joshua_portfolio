---
import MediaLoop from './MediaLoop.astro';
import { url } from '../lib/url';

interface Props {
  project: {
    id: string;
    data: {
      title: string;
      tagline: string;
      org: string;
      period: string;
      summary: string;
      tags: string[];
      video?: string;
      poster?: string;
      thumbnail?: string;
      mediaCredit?: { text: string; href?: string };
      metrics: { value: string; label: string }[];
    };
  };
  index: number;
}

const { project, index } = Astro.props;
const d = project.data;
// Prefer a dedicated card image; fall back to the hero poster.
const cardImage = d.thumbnail ?? d.poster;
const href = url(`/work/${project.id}`);
---

<article class="card">
  <div class="card__media">
    <a class="card__media-link" href={href} tabindex="-1" aria-hidden="true">
      <MediaLoop
        video={d.video}
        poster={cardImage}
        alt={`${d.title} - ${d.tagline}`}
        ratio="16 / 10"
        slotLabel="footage"
      />
    </a>
    <p class="card__credit">
      {
        d.mediaCredit && (
          <>
            Image:{' '}
            {d.mediaCredit.href ? (
              <a href={d.mediaCredit.href} rel="noopener nofollow">
                {d.mediaCredit.text}
              </a>
            ) : (
              d.mediaCredit.text
            )}
          </>
        )
      }
    </p>
  </div>

  <div class="card__body">
    <p class="card__meta mono">{d.org} ({d.period})</p>

    <h3 class="card__title">
      <a href={href}>{d.title}</a>
    </h3>

    <p class="card__tagline">{d.tagline}</p>
    <p class="card__summary">{d.summary}</p>

    <ul class="card__tags">
      {d.tags.map((t) => <li>{t}</li>)}
    </ul>
  </div>
</article>

<style>
  /* Single column: the card is a rail item now, not a full-width row, so the
     media sits above the body rather than beside it. */
  .card {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    height: 100%;
  }

  .card__media {
    min-width: 0;
  }

  .card__media-link {
    display: block;
    text-decoration: none;
    min-width: 0;
  }

  /* Rendered on every card, empty or not: the credit strip reserves one line
     so that a card carrying a credit (Fastbots) does not push its body - and
     every line under it - lower than the rest of the rail. */
  .card__credit {
    margin: 0.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.4;
    min-height: 1.4em;
    letter-spacing: 0.05em;
    color: var(--text-faint);
  }

  .card__credit a {
    color: inherit;
  }

  .card__credit a:hover {
    color: var(--accent);
  }

  .card__body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* Push the tag list to the bottom so cards of differing text length still
     line their tags up across the rail. */
  .card__tags {
    margin-top: auto;
  }

  .card__meta {
    margin: 0 0 0.7rem;
    /* One line: at rail width the longest org plus period just fits at this
       size; ellipsis is a safety net rather than an expected state. */
    font-size: 0.72rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card__title {
    font-size: 1.32rem;
    margin-bottom: 0.4rem;
  }

  .card__title a {
    text-decoration: none;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 0% 1.5px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.28s ease;
  }

  .card__title a:hover {
    background-size: 100% 1.5px;
  }

  .card__tagline {
    color: var(--accent);
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }

  .card__summary {
    color: var(--text-dim);
    font-size: 0.95rem;
    margin-bottom: 1.35rem;
    /* Four lines keeps the tallest card from setting an excessive rail height.
       The full summary is on the project page. */
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .card__tags li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 0.22rem 0.5rem;
  }

</style>
